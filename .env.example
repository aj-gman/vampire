# Site settings
SITE_NAME_HEADER=Digital Garden
# Bare origin only - the path prefix is configured separately below.
SITE_BASE_URL=
SITE_BASE_PATH=
SITE_MAIN_LANGUAGE=en
BASE_THEME=dark

# Theme (URL to Obsidian theme CSS, leave empty for default)
THEME=

# Feature defaults (applied to all notes unless overridden in frontmatter)
dgHomeLink=true
dgShowBacklinks=true
dgShowLocalGraph=true
dgShowInlineTitle=true
dgShowFileTree=true
dgEnableSearch=true
dgShowToc=true
dgLinkPreview=true
dgShowTags=true
dgPassFrontmatter=false
dgShowGraphDepthControl=true

# Timestamps
SHOW_CREATED_TIMESTAMP=false
SHOW_UPDATED_TIMESTAMP=false
TIMESTAMP_FORMAT=MMM dd, yyyy h:mm a

# Images
USE_FULL_RESOLUTION_IMAGES=false

# Note icons
NOTE_ICON_DEFAULT=
NOTE_ICON_TITLE=false
NOTE_ICON_FILETREE=false
NOTE_ICON_INTERNAL_LINKS=false
NOTE_ICON_BACK_LINKS=false

# UI strings (site language)
UI_BACKLINK_HEADER=
UI_NO_BACKLINKS_MESSAGE=
UI_SEARCH_BUTTON_TEXT=
UI_SEARCH_PLACEHOLDER=
UI_SEARCH_NOT_STARTED_TEXT=
UI_SEARCH_ENTER_HINT=
UI_SEARCH_NAVIGATE_HINT=
UI_SEARCH_CLOSE_HINT=
UI_SEARCH_NO_RESULTS=
UI_SEARCH_PREVIEW_PLACEHOLDER=

# Style Settings plugin
STYLE_SETTINGS_CSS=
STYLE_SETTINGS_BODY_CLASSES=
