---
layout: layouts/note.njk
---
<div class="sheet-wrap narrow"{% if sheet.tilt %} style="--sheet-tilt: {{ sheet.tilt }}deg;"{% endif %}>
  <div class="sheet sheet-note{% if sheet.paper %} paper-{{ sheet.paper }}{% endif %}">
    <div class="tape"></div>
    <div class="sheet-content">
      {{ content | safe }}
    </div>
    {% if sheet.footer %}<div class="running-footer" style="left:32px; right:32px;"><span>{{ sheet.footer.left }}</span><span>{{ sheet.footer.right }}</span></div>{% endif %}
  </div>
</div>
