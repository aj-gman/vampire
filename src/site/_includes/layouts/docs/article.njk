---
layout: layouts/note.njk
---
<div class="sheet-wrap" style="max-width: 880px;{% if sheet.tilt %} --sheet-tilt: {{ sheet.tilt }}deg;{% endif %}">
  <div class="sheet sheet-article{% if sheet.paper %} paper-{{ sheet.paper }}{% endif %}">
    {% if sheet.art_running %}<div class="art-running">{% for item in sheet.art_running %}<span>{{ item }}</span>{% endfor %}</div>{% endif %}
    <div class="masthead">{{ sheet.masthead or title or page.fileSlug }}</div>
    {% if sheet.headline %}<h3 class="art-headline">{{ sheet.headline }}</h3>{% endif %}
    {% if sheet.byline %}<div class="art-byline">{{ sheet.byline }}</div>{% endif %}
    <div class="sheet-content">
      {{ content | safe }}
    </div>
    {% if sheet.footer %}<div class="running-footer"><span>{{ sheet.footer.left }}</span><span>{{ sheet.footer.right }}</span></div>{% endif %}
  </div>
</div>
