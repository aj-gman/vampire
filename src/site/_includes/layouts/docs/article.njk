---
layout: layouts/note.njk
---
<div class="sheet-wrap" style="max-width: 720px;{% if tilt %} --sheet-tilt: {{ tilt }}deg;{% endif %}">
  <div class="sheet sheet-article{% if paper %} paper-{{ paper }}{% endif %}">
    {% if art_running %}<div class="art-running">{% for item in art_running %}<span>{{ item }}</span>{% endfor %}</div>{% endif %}
    <div class="masthead">{{ masthead or title or page.fileSlug }}</div>
    {% if headline %}<h3 class="art-headline">{{ headline }}</h3>{% endif %}
    {% if byline %}<div class="art-byline">{{ byline }}</div>{% endif %}
    <div class="sheet-content">
      {{ content | safe }}
    </div>
    {% if footer %}<div class="running-footer"><span>{{ footer.left }}</span><span>{{ footer.right }}</span></div>{% endif %}
  </div>
</div>
