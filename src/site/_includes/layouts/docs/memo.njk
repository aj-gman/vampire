---
layout: layouts/note.njk
---
<div class="sheet-wrap"{% if tilt %} style="--sheet-tilt: {{ tilt }}deg;"{% endif %}>
  <div class="sheet sheet-memo{% if paper %} paper-{{ paper }}{% endif %}">
    <div class="memo-title">{{ memo_title or title or page.fileSlug }}</div>
    {% if memo_fields %}<div class="memo-fields">
      {% for f in memo_fields %}<div class="f"><span class="k">{{ f.k }}</span><span class="v">{{ f.v }}</span></div>
      {% endfor %}
    </div>{% endif %}
    <div class="sheet-content">
      {{ content | safe }}
    </div>
    {% if stamp %}<div class="stamp">{{ stamp }}</div>{% endif %}
    {% if footer %}<div class="running-footer"><span>{{ footer.left }}</span><span>{{ footer.right }}</span></div>{% endif %}
  </div>
</div>
