---
layout: layouts/note.njk
---
<div class="sheet-wrap"{% if sheet.tilt %} style="--sheet-tilt: {{ sheet.tilt }}deg;"{% endif %}>
  <div class="sheet sheet-report{% if sheet.paper %} paper-{{ sheet.paper }}{% endif %}">
    {% if sheet.paperclip %}<div class="paperclip"></div>{% endif %}
    {% if sheet.stamp_conf %}<div class="stamp-conf">{{ sheet.stamp_conf }}</div>{% endif %}
    <div class="report-title">{{ sheet.report_title or title or page.fileSlug }}</div>
    {% if sheet.report_fields %}<div class="report-grid">
      {% for f in sheet.report_fields %}<div class="cell"><span class="k">{{ f.k }}</span><span class="v{% if f.style %} {{ f.style }}{% endif %}">{{ f.v }}</span></div>
      {% endfor %}
    </div>{% endif %}
    {% if sheet.incident %}<p class="report-incident">{{ sheet.incident }}</p>{% endif %}
    <div class="sheet-content">
      {{ content | safe }}
    </div>
    {% if sheet.coffee %}<div class="coffee"></div>{% endif %}
    {% if sheet.footer %}<div class="running-footer"><span>{{ sheet.footer.left }}</span><span>{{ sheet.footer.right }}</span></div>{% endif %}
  </div>
</div>
